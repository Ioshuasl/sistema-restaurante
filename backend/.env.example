PORT=3000
NODE_ENV=production

DB_NAME=sistema-restaurante
DB_USER=ioshua
DB_PASS=
DB_HOST=restaurante_db
DB_PORT=5432
DB_DIALECT=postgres

JWT_SECRET=

WAHA_API_URL=https://waha.coligfamego.com
WAHA_API_KEY=
# Logs estruturados: stdout sempre; envio ao OpenObserve só se as 3 primeiras estiverem definidas
OPENOBSERVE_URL=
OPENOBSERVE_USER=
OPENOBSERVE_PASSWORD=
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM=backend_restaurante
LOG_LEVEL=info
WHATSAPP_LOG_RETENTION_DAYS=60

# Segredo enviado pela WAHA no header x-webhook-secret (customHeaders do webhook da sessão)
WEBHOOK_SECRET=

FRONTEND_URL=https://gs-sabores.ioshuavps.com.br
PUBLIC_API_URL=https://api-gs-sabores.ioshuavps.com.br
UPLOADS_PUBLIC_URL=https://api-gs-sabores.ioshuavps.com.br

# Vigia da sessão WAHA (ligado por padrão só em produção; WHATSAPP_WATCHDOG=true/false força)
WHATSAPP_WATCHDOG=
WHATSAPP_WATCHDOG_INTERVAL_SEC=60
WHATSAPP_ALERT_AFTER_SEC=180
WHATSAPP_ALERT_REMIND_MIN=180
WHATSAPP_AUTO_RESTART=true
WHATSAPP_AUTO_RESTART_MAX=2
# Destino do alerta (POST JSON com "text"/"content"): n8n, Slack, Discord... Sem isso, só vai para os logs (event=whatsapp.alert)
WHATSAPP_ALERT_WEBHOOK_URL=
